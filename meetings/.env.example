# =============================================================================
# meetings/.env  --  copie ce fichier en .env (setup.sh ecrit les deux
# premieres lignes tout seul). Jamais commite : .env est dans .gitignore.
# =============================================================================

# --- rempli par setup.sh -----------------------------------------------------
# Cle imprimee par la stack. A la main : docker exec vexa-lite cat /run/vexa/key.env
VEXA_API_KEY=
# Vexa Lite (make -C deploy/lite) ecoute sur 8056.
# La stack compose complete (make all) ecoute sur 18056.
VEXA_API_BASE=http://localhost:8056

# --- confort -----------------------------------------------------------------
# Nom que les participants voient dans la liste. Sois explicite : les gens ont
# le droit de savoir qu'un bot de notes est dans l'appel.
VEXA_BOT_NAME=Notes (Achraf)

# Langue forcee (fr, en, es...). LAISSER VIDE est le bon reglage quand les
# appels melangent francais et anglais : Whisper detecte fenetre par fenetre.
VEXA_LANG=

# Secondes avant d'abandonner un appel HTTP a Vexa.
VEXA_TIMEOUT=30

# --- sortie vers le reste de la stack GTM ------------------------------------
# Si rempli, `meet.py notes` POSTe le compte rendu en JSON (Make, n8n, Clay,
# Zapier, un endpoint maison...). Charge utile : markdown + actions +
# decisions + objections. DRY_RUN=1 journalise sans envoyer.
MEETING_WEBHOOK_URL=

# --- resume redige par Claude (OPTIONNEL, seule partie payante) --------------
# Sans cette cle, le compte rendu deterministe fonctionne deja (0 EUR).
# Avec : `meet.py notes --ai` ajoute un resume redige. Compter ~0,05 a 0,15 EUR
# par heure de reunion. Necessite aussi : pip install anthropic
ANTHROPIC_API_KEY=
MEETING_MODEL=claude-opus-5-5
