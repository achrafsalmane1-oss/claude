# Postgres connection string (Neon, Supabase, RDS, or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/havenx"

# Secret used to sign session cookies
AUTH_SECRET="change-me-to-a-long-random-string"

# Base URL of the deployment (used in emails and Stripe redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (leave empty to run with the mock billing service)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# Resend (leave empty to log emails to the console instead of sending)
RESEND_API_KEY=""
EMAIL_FROM="HavenX <notifications@havenx.example>"

# Demo mode: enables the one-click "View live demo" sign-in on the marketing site
DEMO_MODE="true"

# ── Fulfillment providers ──────────────────────────────────────────────
# THE MASTER SWITCH. Unset/false: the entire outbound backend runs on free,
# synchronous mocks (no credits, no domains bought, no real email sent) — the
# whole app and the seeded demo work end-to-end. Set to "true" WITH the keys
# below to provision and run real paying clients.
FULFILLMENT_LIVE="false"

# Cron auth (Vercel cron sends "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=""

# Claude API — campaign copywriting, per-lead niche variants, reply classification
ANTHROPIC_API_KEY=""
COPY_MODEL="claude-opus-4-8"

# Clay — lead sourcing (webhook-source table URL). Results POST back to
# /api/webhooks/clay?secret=<CLAY_WEBHOOK_SECRET>
CLAY_WEBHOOK_URL=""
CLAY_WEBHOOK_SECRET=""

# Moltsets — email finding (LinkedIn→email and name+domain→email)
MOLTSETS_API_KEY=""

# Orbisearch — email verification
ORBISEARCH_API_KEY=""

# Winnr — email infrastructure AND transport (domains, inboxes, warmup,
# send, inbox polling). One account holds every client's domains.
WINNR_API_KEY=""

# Manual reply seam (/api/replies)
REPLY_WEBHOOK_SECRET=""
