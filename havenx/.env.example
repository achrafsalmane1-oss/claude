# Postgres connection string (Neon, Supabase, RDS, or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/havenx"

# Secret used to sign session cookies
AUTH_SECRET="change-me-to-a-long-random-string"

# Base URL of the deployment (used in emails and Stripe redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (leave empty to run with the mock billing service)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# Resend (leave empty to log emails to the console instead of sending)
RESEND_API_KEY=""
EMAIL_FROM="HavenX <notifications@havenx.example>"

# Demo mode: enables the one-click "View live demo" sign-in on the marketing site
DEMO_MODE="true"
