# Postgres connection string (Neon, Supabase, RDS, or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/havenx"

# Secret used to sign session cookies
AUTH_SECRET="change-me-to-a-long-random-string"

# Base URL of the deployment (used in emails and Stripe redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (leave empty to run with the mock billing service)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# Resend (leave empty to log emails to the console instead of sending)
RESEND_API_KEY=""
EMAIL_FROM="HavenX <notifications@havenx.example>"

# Demo mode: enables the one-click "View live demo" sign-in on the marketing site
DEMO_MODE="true"

# ── Fulfillment providers ──────────────────────────────────────────────
# Every key below is optional: when unset, that service runs as a mock and
# the pipeline still works end-to-end. Set a key and the real adapter
# activates automatically (wiring in src/services/index.ts).

# Cron auth (Vercel cron sends "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=""

# Claude API — campaign copywriting, per-lead niche variants, reply classification
ANTHROPIC_API_KEY=""
COPY_MODEL="claude-opus-4-8"

# Clay — lead sourcing (webhook-source table URL + results-webhook secret)
CLAY_WEBHOOK_URL=""
CLAY_WEBHOOK_SECRET=""

# Email finder (unlimited enrichment provider) — endpoint + key
EMAIL_FINDER_API_URL=""
EMAIL_FINDER_API_KEY=""

# Reoon — email verification
REOON_API_KEY=""

# Winner — SMTP inbox platform (plans, domains, inboxes)
WINNER_API_KEY=""

# Instantly (or compatible sending tool) — accounts, warmup, campaigns, leads
INSTANTLY_API_KEY=""
SENDER_WEBHOOK_SECRET=""

# Manual reply seam (/api/replies)
REPLY_WEBHOOK_SECRET=""
