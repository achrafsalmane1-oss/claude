# ---------------------------------------------------------------------------
# Instantly -> Slack bridge configuration
# Copy this file to .env (local) or set these as variables in Railway.
# ---------------------------------------------------------------------------

# Instantly API key (Instantly -> Settings -> Integrations -> API).
# IMPORTANT: regenerate your key if it was ever shared in plain text.
INSTANTLY_API_KEY=your_instantly_api_key_here

# Slack bot token from your Slack app (OAuth & Permissions -> Bot User OAuth Token).
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack signing secret (Slack app -> Basic Information -> Signing Secret).
SLACK_SIGNING_SECRET=your_slack_signing_secret

# The Slack channel to post into (e.g. C0123456789).
# Find it: open the channel in Slack -> channel name -> About -> Channel ID.
SLACK_CHANNEL_ID=C0000000000

# Optional shared secret. If set, configure Instantly to send the same value
# as an "X-Webhook-Secret" header (or ?secret=... on the URL) so only Instantly
# can post to the webhook. Leave blank to disable the check.
INSTANTLY_WEBHOOK_SECRET=

# Set to true ONLY while testing, to forward every reply to Slack (not just
# positive ones). Set back to false for production.
FORWARD_ALL_REPLIES=false
