# --- Colddrops server configuration ---
# Lead data (Moltsets) — required for the Lead finder
MOLTSETS_API_KEY=ms_your_key_here

# Voice (ElevenLabs) — required for live sends; dry-run works without it
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Delivery (Drop Cowboy) — required for live sends; dry-run works without it
DROPCOWBOY_TEAM_ID=
DROPCOWBOY_SECRET=

# Public URL of this server (Drop Cowboy fetches audio + posts webhooks here)
PUBLIC_BASE_URL=http://localhost:8000

# Optional: SQLite path (defaults to server/colddrops.db)
# COLDDROPS_DB=/data/colddrops.db
