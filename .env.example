# Email Bison API key (Franklin workspace-scoped token).
# For the live/published dashboard this belongs in a GitHub repository
# *Secret* named EMAIL_BISON_API_KEY — never commit the real key to git.
EMAIL_BISON_API_KEY=your_email_bison_api_key_here

# API base URL (defaults to the value below if unset).
EMAIL_BISON_BASE_URL=https://send.breakoutcreatives.com/api

# Client name shown on the dashboard.
CLIENT_NAME=Franklin
