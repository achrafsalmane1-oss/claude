# --- Colddrops server configuration ---

# Lead data (Moltsets) — required for the Lead finder
MOLTSETS_API_KEY=ms_your_key_here

# VOICE ------------------------------------------------------------
# Backend: auto (default) | elevenlabs | gtts | chime
#   auto -> elevenlabs if key works, else free gTTS, else offline chime
VOICE_BACKEND=auto
# ElevenLabs (premium voice; needs a PAID plan — free tier is API-blocked)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# DELIVERY (self-operated / BYOC — no reseller) --------------------
# Backend: auto (default) | telnyx | dry_run
DELIVERY_BACKEND=auto
# Telnyx Call Control (dial + answering-machine detection -> play into voicemail)
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=

# Public URL of this server (carrier fetches audio + posts webhooks here)
PUBLIC_BASE_URL=http://localhost:8000

# Optional SQLite path (defaults to server/colddrops.db)
# COLDDROPS_DB=/data/colddrops.db
