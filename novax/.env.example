# ============================================================================
# novaX configuration
#
# Copy to .env and fill in. Everything is validated at boot by src/config/env.ts,
# so a missing or malformed value fails immediately and by name rather than
# surfacing as `undefined` inside a job at 3am.
#
# Only DATABASE_URL is strictly required to start. The rest have working
# defaults; the ones that unlock a feature are marked.
# ============================================================================

# --- Core (required) --------------------------------------------------------

# Postgres connection string. Neon, Supabase, or a local instance.
DATABASE_URL=postgres://novax@localhost:5432/novax

# --- Identity of this deployment --------------------------------------------
# The User-Agent on every outbound HTTP probe is built from these, because spec
# §10 requires an identifying agent with a contact URL. Point CONTACT_URL at a
# page that explains what novaX is and how to opt out.
PUBLIC_BASE_URL=http://localhost:3000
CONTACT_URL=http://localhost:3000/opt-out
USER_AGENT_NAME=novaXBot

# --- Auth -------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Sessions are signed with this; if it is unset the
# process generates a random one at boot and every restart signs out every user.
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# --- Ingestion: daily NRD feed ----------------------------------------------
NRD_FEED_BASE_URL=https://www.whoisds.com/whois-database/newly-registered-domains
# How many days back to fetch. The free feed lags; day-2 is the most recent
# reliably complete file.
NRD_LAG_DAYS=2
# A real day is 250k-450k domains. The free tier occasionally serves a truncated
# file (a 70,000-line one was observed during the build); below this the run is
# recorded with a warning and /health reports it.
NRD_MIN_EXPECTED_DOMAINS=100000

# --- Ingestion: Certificate Transparency ------------------------------------
CT_ENABLED=true
CT_LOG_LIST_URL=https://www.gstatic.com/ct/log_list/v3/log_list.json
# Logs polled concurrently, spread across operators so one outage is not silence.
CT_MAX_LOGS=6
CT_BATCH_SIZE=256
CT_POLL_INTERVAL_MS=3000
# Politeness limit. Observed live: polling harder than this earns HTTP 429 from
# both Google and DigiCert within seconds.
CT_REQUESTS_PER_SECOND_PER_LOG=2
# Spec §11: alert if the CT stream is silent for more than 10 minutes.
CT_SILENCE_ALERT_SECONDS=600
# In-process dedupe window, in apexes. ~2M entries is roughly 120MB.
CT_DEDUPE_LRU_SIZE=2000000

# --- Ingestion: CZDS (optional; built but not scheduled) --------------------
# ICANN zone-file access. Approval is per-TLD and takes days to weeks. Leave
# blank unless you have been approved.
CZDS_USERNAME=
CZDS_PASSWORD=
CZDS_AUTH_URL=https://account-api.icann.org/api/authenticate
CZDS_BASE_URL=https://czds-api.icann.org

# --- Enrichment: DNS (the gate that makes the economics work) ---------------
DNS_SERVERS=1.1.1.1,8.8.8.8
DNS_TIMEOUT_MS=4000
DNS_CONCURRENCY=50

# --- Enrichment: HTTP probe -------------------------------------------------
HTTP_PROBE_TIMEOUT_MS=8000
HTTP_PROBE_MAX_BYTES=524288
HTTP_PROBE_MAX_REDIRECTS=5
HTTP_PROBE_CONCURRENCY=20
# Spec §10 requires this. Setting it to false is a compliance decision, not a
# performance one.
HTTP_RESPECT_ROBOTS=true
BODY_SNIPPET_CHARS=2000

# --- Enrichment: RDAP -------------------------------------------------------
RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
RDAP_FALLBACK_URL=https://rdap.org
# Registries rate-limit per source IP and will ban a hot caller.
RDAP_RPS_PER_REGISTRY=1
RDAP_BURST_PER_REGISTRY=5
RDAP_TIMEOUT_MS=10000

# --- Enrichment budget (spec §6) --------------------------------------------
# Per-domain ceiling in micro-USD (1,000,000 = $1). A domain that exceeds this
# stops being enriched. Measured actual during the build: ~15 micro-USD/domain.
ENRICHMENT_BUDGET_MICRO_USD=200
MAX_ENRICHMENT_FAILURES=5

# --- Queue ------------------------------------------------------------------
# Batch sizes are what keep pg-boss at ~14k jobs/day instead of ~1.2M. See the
# sizing note in DECISIONS.md before raising them.
QUEUE_DNS_BATCH_SIZE=500
QUEUE_HTTP_BATCH_SIZE=25
QUEUE_RDAP_BATCH_SIZE=25
QUEUE_CONCURRENCY=5
QUEUE_SCHEMA=pgboss

# --- Scoring: LLM classifier ------------------------------------------------
# Without a key the pipeline still runs; it scores on rules signals alone, which
# measurably cannot separate a slot-gambling site from a real local business.
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-opus-5
CLASSIFIER_ENABLED=true
# The Batch API is 50% cheaper and this workload has no latency requirement.
CLASSIFIER_USE_BATCH=true
CLASSIFIER_MAX_PER_RUN=5000

# Score thresholds for the hot/warm/cold/junk tiers.
SCORE_TIER_HOT=80
SCORE_TIER_WARM=60
SCORE_TIER_COLD=40

# --- Delivery ---------------------------------------------------------------
# Needed for daily digest emails only.
RESEND_API_KEY=
DIGEST_FROM_EMAIL=novaX <digest@yourdomain.com>
WEBHOOK_TIMEOUT_MS=10000
# Consecutive failures before a webhook endpoint is disabled.
WEBHOOK_MAX_ATTEMPTS=6

# --- Ops --------------------------------------------------------------------
# Any URL that accepts a JSON POST: Slack and Discord incoming webhooks both work.
ALERT_WEBHOOK_URL=
LOG_LEVEL=info
