# ---------------------------------------------------------------------------
# Copy to .env and fill in. Everything here has a working default except the
# values marked REQUIRED IN PRODUCTION.
# ---------------------------------------------------------------------------

# Branding shown across the marketing site and app
BRAND_NAME=LeadMaps
BRAND_TAGLINE=Local business lead lists, on tap.
SUPPORT_EMAIL=support@yourdomain.com
PUBLIC_URL=https://yourdomain.com

# REQUIRED IN PRODUCTION. Generate with: openssl rand -hex 32
SECRET_KEY=

# SQLite is fine to start. Move to Postgres before you have paying customers.
DATABASE_URL=sqlite:///./leadmaps.db
# DATABASE_URL=postgresql+psycopg://leadmaps:password@postgres:5432/leadmaps

# ---------------------------------------------------------------------------
# Scraping engine
#   local = REAL data. Runs the google-maps-scraper CLI per search. Needs only
#           Docker (or a scraper binary). This is the default.
#   http  = REAL data via a full google-maps-scraper SaaS deployment, with a
#           queue and horizontal workers. Use this at volume.
#   mock  = FAKE generated data, for tests and UI work. Never sell it.
# ---------------------------------------------------------------------------
ENGINE_MODE=local

# --- local mode ---
# Leave ENGINE_BINARY empty to run the scraper via Docker.
ENGINE_BINARY=
ENGINE_DOCKER_IMAGE=gosom/google-maps-scraper:latest
ENGINE_WORKDIR=./scrape-jobs
ENGINE_JOB_TIMEOUT=1800
ENGINE_CONCURRENCY=4
# Strongly recommended at any real volume: Google rate-limits datacentre IPs.
ENGINE_PROXIES=

# --- http mode ---
ENGINE_URL=http://engine:8080
ENGINE_API_KEY=
ENGINE_TIMEOUT=30

# ---------------------------------------------------------------------------
# Stripe. Leave STRIPE_SECRET_KEY empty and plan changes apply without payment
# (development mode). Set it and the same buttons start charging.
# STRIPE_PRICES maps plan codes to Stripe price ids.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICES=starter=price_xxx,growth=price_yyy,scale=price_zzz

# Operational
SIGNUP_ENABLED=true
MAX_CONCURRENT_JOBS=5
DEBUG=false
